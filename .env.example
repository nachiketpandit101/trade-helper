# Copy this file to .env and fill in real values.
# Get a free API key at https://finnhub.io/

FINNHUB_API_KEY=your_finnhub_api_key_here

# Comma-separated list of stock symbols to watch.
TICKERS=AAPL,TSLA,NVDA

# Optional. How often to poll when the loop mode lands (e.g. "15m", "1h",
# or a bare integer interpreted as minutes). Default: 15m.
FETCH_INTERVAL=15m
